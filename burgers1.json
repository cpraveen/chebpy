an></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.7693em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.3407em;\"><span></span></span></span></span></span></span></span><span class=\"tag\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.8407em;\"><span style=\"top:-4.9844em;\"><span class=\"pstrut\" style=\"height:3.6349em;\"></span><span class=\"eqn-num\"></span></span><span style=\"top:-2.3636em;\"><span class=\"pstrut\" style=\"height:3.6349em;\"></span><span class=\"eqn-num\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.3407em;\"><span></span></span></span></span></span></span></span></span>","enumerator":"4","key":"KCBnBlmfAp"}],"identifier":"7db165b2-49e0-4f33-b9af-2201a597d026","html_id":"7db165b2-49e0-4f33-b9af-2201a597d026","key":"kxZUkf4jd9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pylab import *\nfrom matplotlib.collections import PolyCollection","key":"J0uG3MF5FM"},{"type":"outputs","id":"EyHwhBV3WlALuS9p1Azoe","children":[],"key":"ekYuZx87wQ"}],"identifier":"fc5715af-d27f-499f-95a7-92ab8523efa0","html_id":"fc5715af-d27f-499f-95a7-92ab8523efa0","key":"ynsKtAxl8I"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"nu = 1.0e-2\nN  = 128\nh  = 2*pi/N\nx  = h * arange(N)\n\nt = 0.0; dt = h/5.0\ntmax = 4.0; tplot = 0.1;\nplotgap = int(round(tplot/dt)); dt = tplot/plotgap;\nnplots = int(round(tmax/tplot))\n\nk = 2*pi*fftfreq(N,h)\nmu = 1.0/(1.0 + nu * dt * k**2)\n\n# Initial condition\nv = 1.0/cosh(4*(x-pi))\n\ndata = []; data.append(list(zip(x, v)))\ntdata = []; tdata.append(0.0)\n\nfor i in range(1,nplots):\n    for n in range(plotgap):\n        t = t + dt\n        vh = fft(v)\n        fh = fft(0.5*v**2)\n        vh = mu * (vh - dt * 1j * k * fh)\n        v = real(ifft(vh))\n    data.append(list(zip(x, v)))\n    tdata.append(t);\n\nfig = figure(figsize=(12,10))\nax = fig.add_subplot(111,projection='3d')\npoly = PolyCollection(data, closed=False, facecolors='white', edgecolors='red')\npoly.set_alpha(1)\nax.add_collection3d(poly, zs=tdata, zdir='y')\nax.set_xlabel('x'); ax.set_ylabel('t'); ax.set_zlabel('v')\nax.set_xlim3d(0, 2*pi); ax.set_ylim3d(0, 4); ax.set_zlim3d(0, 1)\nax.view_init(40,-70)\nax.set_box_aspect(aspect=(1, 1, 0.5))","key":"GsQ9GLnjPQ"},{"type":"outputs","id":"XVs2yZReFQbvhmSDTMOQQ","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"94f0f1d3849e0da34965b502a8a7be6e","path":"/build/94f0f1d3849e0da34965b502a8a7be6e.png"},"text/plain":{"content":"<Figure size 1200x1000 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"anb7jybKlR"}],"key":"jFFEFowGZe"}],"identifier":"1db6fab9-1d37-4656-837b-d61d60b9b276","html_id":"1db6fab9-1d37-4656-837b-d61d60b9b276","key":"NB4SCofuNg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Animation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w4OqYzeqab"}],"identifier":"animation","label":"Animation","html_id":"animation","implicit":true,"key":"Xykp79eW4R"}],"identifier":"22944704-e543-4654-9a18-f573c93c0b04","html_id":"22944704-e543-4654-9a18-f573c93c0b04","key":"aDS7Z7S4Ax"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nfrom matplotlib import animation\nfrom matplotlib import rc\nrc('animation', html='jshtml')\n\n# First set up the figure, the axis, and the plot element we want to animate\nfig = plt.figure()\nax = plt.axes(xlim=(0, 2*pi), ylim=(-0.1, 1.1))\nline, = ax.plot([], [], 'r-', lw=2, label='u')\nax.set_xlabel('x'); ax.set_ylabel('u')\nplt.close();\n\n# initialization function: plot the background of each frame\ndef init():\n    line.set_data([], [])\n    return line,\n\n# animation function.  This is called sequentially\ndef animate(i):\n    x, v = zip(*data[i])\n    line.set_data(x, v)\n    return line,\n\n# call the animator.  blit=True means only re-draw the parts that have changed.\nanim = animation.FuncAnimation(fig, animate, init_func=init, repeat=False,\n                               frames=len(data), interval=50, blit=True)\n\n# Save to file\n#try:\n#    anim.save('p06.mp4', fps=20, extra_args=['-vcodec', 'libx264'])\n#except:\n#    print(\"Cannot save mp4 file\")","key":"Jjma70rR7b"},{"type":"outputs","id":"5s50oQUPQ-t-9MOH6lKA1","children":[],"key":"zblVFM1lNk"}],"identifier":"bc44d38c-8dce-4fb1-aaaf-3108c9ee1d54","html_id":"bc44d38c-8dce-4fb1-aaaf-3108c9ee1d54","key":"zrCR1WmGns"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"anim","key":"uun4ss9U7Q"},{"type":"outputs","id":"ZPUeiYbFv-W9QvVw8ORxi","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":54,"metadata":{},"data":{"text/html":{"content_type":"text/html","hash":"eb8303a6b73eea8498a46276c07b9c1a","path":"/build/eb8303a6b73eea8498a46276c07b9c1a.html"},"text/plain":{"content":"<matplotlib.animation.FuncAnimation at 0x122029130>","content_type":"text/plain"}}},"children":[],"key":"yyYqUVcDys"}],"key":"AnTwnNa4Mx"}],"identifier":"99e65ac4-1d5d-4104-9dcd-b30fd447b446","html_id":"99e65ac4-1d5d-4104-9dcd-b30fd447b446","key":"z1IeAOhRtl"}],"key":"i7TEgxS8cq"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Linear advection equation using FFT and RK4","url":"