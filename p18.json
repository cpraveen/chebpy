{"version":3,"kind":"Notebook","sha256":"2067bebdcd5488b341f52244fe116876bab7d94fd0dc81f3caac5efc3b7316d4","slug":"p18","location":"/p18.ipynb","dependencies":[],"frontmatter":{"title":"p18: Chebyshev differentiation via FFT","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Praveen Chandrashekar","given":"Praveen","family":"Chandrashekar"},"name":"Praveen Chandrashekar","github":"cfdlab","twitter":"cfdlab","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cpraveen/chebpy","copyright":"2026","source_url":"https://github.com/cpraveen/chebpy/blob/master/p18.ipynb","edit_url":"https://github.com/cpraveen/chebpy/edit/master/p18.ipynb","exports":[{"format":"ipynb","filename":"p18.ipynb","url":"/build/p18-5c530ec711118c3fd6ebdb412a6a43c2.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We repeat p11 but using FFT.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FjLjARL5HT"}],"key":"TE2Z0h7y4O"}],"key":"YiwoCAfbUv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%config InlineBackend.figure_format = 'svg'\nfrom chebfftPy import chebfft\nfrom numpy import pi,linspace,sin,cos,exp,round,zeros,arange,real,flipud\nfrom numpy.fft import fft,ifft\nfrom matplotlib.pyplot import figure,subplot,plot,grid,title,axis","key":"BsCK7jm0lx"},{"type":"outputs","id":"mFan2lWBsXKDzwXz2h5Qt","children":[],"key":"hmWQIPBhCu"}],"key":"khq4DvOcQk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"figure(figsize=(10,12))\nplot_count = 1\n\nfor N in [10,20]:\n    xx = linspace(-1.0,1.0,100)\n    ff = exp(xx)*sin(5*xx)\n    x = cos(arange(0,N+1)*pi/N)\n    f = exp(x)*sin(5*x)\n    error = chebfft(f) - exp(x)*(sin(5*x)+5*cos(5*x))\n    subplot(3,2,plot_count); plot_count +=1\n    plot(xx,ff,'-',x,f,'o')\n    grid(True)\n    axis([-1, 1, -4,2])\n    title('f(x), N='+str(N))\n    subplot(3,2,plot_count); plot_count +=1\n    plot(x,error,'-o')\n    title('error in f\\'(x), N='+str(N))\n    grid(True)","key":"cm5KQzKF8x"},{"type":"outputs","id":"eUw63Ult7Q_o3DLijtwJ0","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/svg+xml":{"content_type":"image/svg+xml","hash":"16fe52a08cbe8e7e10b0e6e31e9b6457","path":"/build/16fe52a08cbe8e7e10b0e6e31e9b6457.svg"},"text/plain":{"content":"<Figure size 1000x1200 with 4 Axes>","content_type":"text/plain"}}},"children":[],"key":"dlDVfHuGKE"}],"key":"QB0AYvt8Q4"}],"key":"KylsmSA4Iq"}],"key":"Bkj7GECvgE"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p17: Helmholtz Equation in 2-D","url":"/p17","group":"Spectral Methods"},"next":{"title":"p19: Second order Wave Equation on Chebyshev Grid","url":"/p19","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}