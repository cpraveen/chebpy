{"version":3,"kind":"Notebook","sha256":"3d298e44e179933760eba3fc5a70eb4394a261ff81b3538788e1f57a80a41389","slug":"p05c","location":"/p05c.ipynb","dependencies":[],"frontmatter":{"title":"p05c: Repetition of p05 using scipy.fftpack.diff","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Praveen Chandrashekar","given":"Praveen","family":"Chandrashekar"},"name":"Praveen Chandrashekar","github":"cfdlab","twitter":"cfdlab","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cpraveen/chebpy","copyright":"2026","source_url":"https://github.com/cpraveen/chebpy/blob/master/p05c.ipynb","edit_url":"https://github.com/cpraveen/chebpy/edit/master/p05c.ipynb","exports":[{"format":"ipynb","filename":"p05c.ipynb","url":"/build/p05c-508f50b5323a0639633926de7fc42dc8.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"link","url":"https://docs.scipy.org/doc/scipy/reference/fftpack.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"scipy.fftpack","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mwjV3Q9KAR"}],"urlSource":"https://docs.scipy.org/doc/scipy/reference/fftpack.html","key":"OUndzydgFB"},{"type":"text","value":" is considered legacy package and may not receive updates.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XM5mPkY8pR"}],"key":"BPt8UPHWjR"}],"key":"sSIGnqMBzb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#%config InlineBackend.figure_format='svg'\n#  For complex v, delete \"real\" commands.\nfrom numpy import pi,inf,linspace,maximum,abs,zeros,arange,real,sin,cos,exp\nfrom scipy.fftpack import diff\nfrom numpy.linalg import norm\nfrom matplotlib.pyplot import figure,subplot,plot,axis,title,text","key":"c4jVLXHhiW"},{"type":"outputs","id":"ojjbzcmzfjaol5DktZo_m","children":[],"key":"rduFoETIqZ"}],"key":"ccN91GpQiE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set up grid and differentiation matrix:\nN = 24; h = 2*pi/N; x = h*arange(1,N+1);\n\n# Differentiation of a hat function:\nv = maximum(0.0,1.0-abs(x-pi)/2.0)\nw = diff(v)\n\nfigure(figsize=(10,6))\n\nsubplot(3,2,1)\nplot(x,v,'.-')\naxis([0, 2*pi, -.5, 1.5])\ntitle('function')\nsubplot(3,2,2)\nplot(x,w,'.-')\naxis([0, 2*pi, -1, 1])\ntitle('spectral derivative')\n\n# Differentiation of exp(sin(x)):\nv = exp(sin(x)); vprime = cos(x)*v;\nw = diff(v)\n\nsubplot(3,2,3)\nplot(x,v,'.-')\naxis([0, 2*pi, 0, 3])\nsubplot(3,2,4)\nplot(x,w,'.-')\naxis([0, 2*pi, -2, 2])\nerror = norm(w-vprime,inf)\ntext(1.5,1.4,\"max error=\"+str(error));","key":"iR0pGvcX5C"},{"type":"outputs","id":"9jzeYx9COAVmjKNPqnkoT","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x600 with 4 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"79c83e241b9b80a61df790caa58226af","path":"/build/79c83e241b9b80a61df790caa58226af.png"}}},"key":"Adt4Db8RkI"}],"key":"wzyA1shwae"}],"key":"EMiUNOdWI1"}],"key":"Qy7jXQXsny"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p05b: Repetition of p05 via real FFT","url":"/p05b","group":"Spectral Methods"},"next":{"title":"p06: Variable coefficient wave equation","url":"/p06","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}