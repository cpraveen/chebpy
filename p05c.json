{"version":3,"kind":"Notebook","sha256":"7ac1c8aa18224db1fd07e6226af748de8ae0a7b891d1e1b4e59a35518001f3ea","slug":"p05c","location":"/p05c.ipynb","dependencies":[],"frontmatter":{"title":"p05c: Repetition of p05 using scipy.fftpack.diff","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Praveen Chandrashekar","given":"Praveen","family":"Chandrashekar"},"name":"Praveen Chandrashekar","github":"cfdlab","twitter":"cfdlab","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cpraveen/chebpy","copyright":"2026","source_url":"https://github.com/cpraveen/chebpy/blob/master/p05c.ipynb","edit_url":"https://github.com/cpraveen/chebpy/edit/master/p05c.ipynb","exports":[{"format":"ipynb","filename":"p05c.ipynb","url":"/chebpy/build/p05c-d102d88b3a7cda2c3687ec17af46aeb9.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"link","url":"https://docs.scipy.org/doc/scipy/reference/fftpack.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"scipy.fftpack","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WgC5cF3jg4"}],"urlSource":"https://docs.scipy.org/doc/scipy/reference/fftpack.html","key":"Sgbh5R2qq6"},{"type":"text","value":" is considered legacy package and may not receive updates.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wJflJ1fJT1"}],"key":"geXbO6YeLC"}],"key":"FfJ55eR5Qm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%config InlineBackend.figure_format='svg'\n#  For complex v, delete \"real\" commands.\nfrom numpy import pi,inf,linspace,maximum,abs,zeros,arange,real,sin,cos,exp\nfrom scipy.fftpack import diff\nfrom numpy.linalg import norm\nfrom matplotlib.pyplot import figure,subplot,plot,axis,title,text","key":"SvGEWxZp34"},{"type":"outputs","id":"f1Mo2T8doJUE3mahQDFMg","children":[],"key":"yJ5BONCkJv"}],"key":"qLoINbZLX0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set up grid and differentiation matrix:\nN = 24; h = 2*pi/N; x = h*arange(1,N+1);\n\n# Differentiation of a hat function:\nv = maximum(0.0,1.0-abs(x-pi)/2.0)\nw = diff(v)\n\nfigure(figsize=(10,6))\n\nsubplot(3,2,1)\nplot(x,v,'.-')\naxis([0, 2*pi, -.5, 1.5])\ntitle('function')\nsubplot(3,2,2)\nplot(x,w,'.-')\naxis([0, 2*pi, -1, 1])\ntitle('spectral derivative')\n\n# Differentiation of exp(sin(x)):\nv = exp(sin(x)); vprime = cos(x)*v;\nw = diff(v)\n\nsubplot(3,2,3)\nplot(x,v,'.-')\naxis([0, 2*pi, 0, 3])\nsubplot(3,2,4)\nplot(x,w,'.-')\naxis([0, 2*pi, -2, 2])\nerror = norm(w-vprime,inf)\ntext(1.5,1.4,\"max error=\"+str(error));","key":"gE1TG7YLvo"},{"type":"outputs","id":"13tnj4lxMtA4MAwrDEQty","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/svg+xml":{"content_type":"image/svg+xml","hash":"5794863a29229ad1b98afd58c94781d3","path":"/chebpy/build/5794863a29229ad1b98afd58c94781d3.svg"},"text/plain":{"content":"<Figure size 1000x600 with 4 Axes>","content_type":"text/plain"}}},"children":[],"key":"LFLTMJaIYy"}],"key":"YLeM5Vx6jM"}],"key":"LQOCSeq6QQ"}],"key":"Ox3mi50X8w"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p05b: Repetition of p05 via real FFT","url":"/p05b","group":"Spectral Methods"},"next":{"title":"p06: Variable coefficient wave equation","url":"/p06","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}