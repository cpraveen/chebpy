ort linspace,exp,sin,dot\nfrom matplotlib.pyplot import figure,subplot,plot,title\nfrom chebPy import *","key":"bGwZiEFQWH"},{"type":"outputs","id":"9N4KHZO2r9GMvIQ6P5Tjp","children":[],"key":"aZ3OoF0aYf"}],"key":"IjOJ0ZjqTd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"xx = linspace(-1.0,1.0,200,True)\nuu = exp(xx)*sin(5.0*xx)\nc = 1; figure(figsize=(10,8))\nfor N in [10,20]:\n    D,x = cheb(N); u = exp(x)*sin(5.0*x)\n    subplot(2,2,c); c += 1\n    plot(x,u,'o',xx,uu)\n    title('u(x), N='+str(N))\n    \n    error = dot(D,u) - exp(x)*(sin(5.0*x)+5.0*cos(5.0*x))\n    subplot(2,2,c); c += 1\n    plot(x,error,'o-')\n    title('error in u\\'(x), N='+str(N));","key":"Jqmv6Axh26"},{"type":"outputs","id":"TrWkQQF7MLQmLHqbag2St","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/svg+xml":{"content_type":"image/svg+xml","hash":"c5235012952bda55b745fbd4cadf5997","path":"/chebpy/build/c5235012952bda55b745fbd4cadf5997.svg"},"text/plain":{"content":"<Figure size 1000x800 with 4 Axes>","content_type":"text/plain"}}},"children":[],"key":"eHnW5ifidK"}],"key":"iJiYWAg5hD"}],"key":"N5nZ3pbabM"}],"key":"PVDxYj4TKe"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p10: Polynomials and corresponding equipotential curves","url":"/p10","group":"Spectral Methods"},"next":{"title":"p12: Accuracy of Chebyshev spectral differentiation","url":"/p12","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}