ss=\"mord mathnormal\">u</span><span class=\"mopen\">(</span><span class=\"mord\">±</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">t</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0</span></span></span></span></span>","enumerator":"2","key":"QqPuVNvYdU"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"and initial condition","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"Ic023OEiBy"}],"key":"c2ACZzxDWY"},{"type":"math","value":"u(x,0) = e^{-200 x^2}","position":{"start":{"line":15,"column":1},"end":{"line":17,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>u</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo separator=\"true\">,</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mo>=</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>200</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></msup></mrow><annotation encoding=\"application/x-tex\">u(x,0) = e^{-200 x^2}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">u</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.0369em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.0369em;\"><span style=\"top:-3.113em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">200</span><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">x</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8913em;\"><span style=\"top:-2.931em;margin-right:0.0714em;\"><span class=\"pstrut\" style=\"height:2.5em;\"></span><span class=\"sizing reset-size3 size1 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span></span>","enumerator":"3","key":"FusylSFrT7"}],"key":"BeTCJa4bEF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#%config InlineBackend.figure_format = 'svg'\nfrom chebfftPy import chebfft\nfrom numpy import arange,cos,zeros,round,exp,pi,linspace\nfrom matplotlib.collections import LineCollection\nfrom matplotlib.pyplot import figure\nfrom scipy.interpolate import BarycentricInterpolator","key":"G6W1LxZnEl"},{"type":"outputs","id":"Qtud-l_-0QeImUXjVV0Df","children":[],"key":"uR8521JlFJ"}],"key":"wSnlILYwQI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Time-stepping by Leap Frog Formula:\nN = 80; t = 0.0; x = cos(pi*arange(0,N+1)/N); dt = 8.0/(N**2);\ntmax = 4 ; tplot = 0.1;\nplotgap = int(round(tplot/dt)); dt = tplot/plotgap;\nnplots = int(round(tmax/tplot))+1;\nv = exp(-200*x**2)         # Solution at n\nvold = exp(-200*(x-dt)**2) # Solution at n-1\nplotdata = []; plotdata.append(list(zip(x,v)));\ntdata = []; tdata.append(0.0)\nfor i in range(1,nplots):\n    for n in range(plotgap):\n        t = t + dt\n        w = chebfft(chebfft(v)); w[0] = 0.0; w[N] = 0.0; \n        vnew = 2*v - vold + dt**2*w; vold = v; v = vnew;\n    plotdata.append(list(zip(x,v)));\n    tdata.append(t);\n\nfig = figure(figsize=(10,12))\nax = fig.add_subplot(111,projection='3d')\npoly = LineCollection(plotdata)\npoly.set_alpha(0.5)\nax.add_collection3d(poly, zs=tdata, zdir='y')\nax.set_xlabel('x'); ax.set_ylabel('t'); ax.set_zlabel('v')\nax.set_xlim3d(-1, 1); ax.set_ylim3d(0, tmax); ax.set_zlim3d(-1.5, 1.5)\nax.view_init(40,-50), ax.set_box_aspect(aspect=(0.5, 1, 0.2));","key":"n7YCJ3WOA7"},{"type":"outputs","id":"u8SE8JFiEiCeNOuCYU5bp","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x1200 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"196ed4c13e056d7f72401dff4552e340","path":"/chebpy/build/196ed4c13e056d7f72401dff4552e340.png"}}},"key":"zM3x0gF6Q8"}],"key":"t0X52JUOT4"}],"key":"IlbLEAxbnY"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Note that the boundary conditions do not depend on time; they are satisfied initially and we do not change these values during the time stepping. This is accomplished by setting ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eQoRbfhsPk"},{"type":"inlineCode","value":"w[0] = w[N] = 0","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"soWKwZHkK5"},{"type":"text","value":".","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FFGM7rvnvi"}],"key":"JpMEaKpiyr"}],"key":"tDhDoAwRSO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make animation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LNtMGbcb9S"}],"identifier":"make-animation","label":"Make animation","html_id":"make-animation","implicit":true,"key":"zy1RFgI2Is"}],"key":"ja59jCYvHi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nfrom matplotlib import animation\nfrom matplotlib import rc\nrc('animation', html='jshtml')\n\n# Interpolate to finer grid for plotting\nP = BarycentricInterpolator(x)\nxx = linspace(-1,1,200)\n\n# First set up the figure, the axis, and the plot element we want to animate\nfig = plt.figure()\nax = plt.axes(xlim=(-1,1), ylim=(-1.5, 1.5))\nline, = ax.plot([], [], lw=2)\nplt.xlabel('x'); plt.ylabel('v'); plt.grid(True)\nplt.close()\n\n# initialization function: plot the background of each frame\ndef init():\n    line.set_data([], [])\n    return line,\n\n# animation function.  This is called sequentially\ndef animate(i):\n    x, v = zip(*plotdata[i])\n    P.set_yi(v)\n    line.set_data(xx, P(xx))\n    ax.set_title(\"t = \"+str(tdata[i]))\n    return line,\n\n# call the animator.  blit=True means only re-draw the parts that have changed.\nanim = animation.FuncAnimation(fig, animate, init_func=init, repeat=False,\n                               frames=len(plotdata), interval=50, blit=True)\n# Save to file\ntry:\n    anim.save('p19.mp4', fps=20, extra_args=['-vcodec', 'libx264'])\nexcept:\n    print(\"Cannot save mp4 file\")","key":"XZ8RlQxmEH"},{"type":"outputs","id":"irGwaSWbNftAMN050IylA","children":[],"key":"C3LhGCNcfl"}],"key":"mIjwae05Cd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"anim","key":"iAVaMknb5I"},{"type":"outputs","id":"xvceQXMQmUIsxG68YNdNo","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"<matplotlib.animation.FuncAnimation at 0x14a155a90>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"d669978c80748cb75adefb677b162384","path":"/chebpy/build/d669978c80748cb75adefb677b162384.html"}}},"key":"vJK8vtJmar"}],"key":"YnJzIUfFtM"}],"key":"TwYtqdJWhF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Use this for inline display of movie\n#from IPython.display import HTML\n#HTML(anim.to_html5_video())","key":"G8LcsWBRtz"},{"type":"outputs","id":"Hw1_WB0QbfjIZkLCLM96V","children":[],"key":"xXpw8QDQ2w"}],"key":"bDNabtjwg6"}],"key":"uGgpymi7M0"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p18: Chebyshev differentiation via FFT","url":"/p18","group":"Spectral Methods"},"next":{"title":"p20: Second order wave equation in 2-D via FFT","url":"/p20","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}