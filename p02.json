{"version":3,"kind":"Notebook","sha256":"eebf20bebf3877e562a0f0b3b36aed2d909201e60155101b518381eb54f28565","slug":"p02","location":"/p02.ipynb","dependencies":[],"frontmatter":{"title":"p02: Convergence of periodic spectral method","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Praveen Chandrashekar","given":"Praveen","family":"Chandrashekar"},"name":"Praveen Chandrashekar","github":"cfdlab","twitter":"cfdlab","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cpraveen/chebpy","copyright":"2026","source_url":"https://github.com/cpraveen/chebpy/blob/master/p02.ipynb","edit_url":"https://github.com/cpraveen/chebpy/edit/master/p02.ipynb","exports":[{"format":"ipynb","filename":"p02.ipynb","url":"/build/p02-ceaaab10e94ac862416844d0d1da95d0.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We repeat program P1 using periodic spectral method to compute derivative of","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QOmcm9RMQa"}],"key":"vX3IztLcXY"},{"type":"math","value":"u(x) = \\exp(\\sin(x)), \\qquad x \\in [-\\pi,\\pi]","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>u</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mi>exp</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>sin</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">)</mo><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>x</mi><mo>∈</mo><mo stretchy=\"false\">[</mo><mo>−</mo><mi>π</mi><mo separator=\"true\">,</mo><mi>π</mi><mo stretchy=\"false\">]</mo></mrow><annotation encoding=\"application/x-tex\">u(x) = \\exp(\\sin(x)), \\qquad x \\in [-\\pi,\\pi]</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">u</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mop\">exp</span><span class=\"mopen\">(</span><span class=\"mop\">sin</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">))</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:2em;\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">x</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">∈</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">[</span><span class=\"mord\">−</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">π</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">π</span><span class=\"mclose\">]</span></span></span></span></span>","enumerator":"1","key":"gVFmuYb95O"}],"key":"fiFiWacw0l"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#%config InlineBackend.figure_format='svg'\nfrom scipy.linalg import toeplitz\nfrom numpy import pi,arange,exp,sin,cos,zeros,tan,inf\nfrom numpy.linalg import norm\nfrom matplotlib.pyplot import figure,loglog,grid,xlabel,ylabel","key":"FIM03C9Nz0"},{"type":"outputs","id":"eAbEdA9D968Op9AAt3MP1","children":[],"key":"nCenebOFRD"}],"key":"lE4zgaezHg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"figure()\nfor N in range(2,100,2):\n    h = 2.0*pi/N\n    x = -pi + arange(1,N+1)*h\n    u = exp(sin(x))\n    uprime = cos(x)*u # Exact derivative\n    col = zeros(N)\n    col[1:] = 0.5*(-1.0)**arange(1,N)/tan(arange(1,N)*h/2.0)\n    row = zeros(N); row[0] = col[0]; row[1:] = col[N-1:0:-1]\n    D = toeplitz(col,row)\n    error = norm(D.dot(u)-uprime,inf)\n    loglog(N,error,'or')\n    \ngrid(True); xlabel('N'); ylabel('error');","key":"e0SuboritS"},{"type":"outputs","id":"LJ0HZ4t9wB5bIWPk52V7P","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"ad79cc8d7a5d36f1343bd656e79abd1a","path":"/build/ad79cc8d7a5d36f1343bd656e79abd1a.png"}}},"key":"rb2iWEabgk"}],"key":"cptL8fUSpc"}],"key":"RbWvrFY4Qf"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"With about 24 points, the error is of order ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"K4bhZ3jQQF"},{"type":"span","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"10","key":"Ov3wA9ehe3"},{"type":"superscript","children":[{"type":"text","value":"-12","key":"E6FxrIYPfV"}],"key":"DG6Rk3nPqV"}],"key":"ZtigFhOZqX"},{"type":"text","value":", compare this to the finite difference method in p01.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ImJ8TUn7dd"}],"key":"B0VeJ2Zynv"}],"key":"lPGfOim7x6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Exercise","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JdbueioPxf"}],"identifier":"exercise","label":"Exercise","html_id":"exercise","implicit":true,"key":"yY5MGVgdqR"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"A Toepliz matrix is generated by its first column and first row. In the present case, we could also do","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Ip4c8DApNO"}],"key":"RSocYe2jto"},{"type":"code","lang":"python","value":"D = toeplitz(col, -col)","position":{"start":{"line":4,"column":1},"end":{"line":6,"column":1}},"key":"rYa1xARpAN"}],"key":"dFiPjOKw8K"}],"key":"yxsACeuGRg"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p01: Convergence of fourth order finite differences","url":"/p01","group":"Spectral Methods"},"next":{"title":"p03: Band-limited interpolation","url":"/p03","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}