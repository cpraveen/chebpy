 + u_{xxx} = 0, \\qquad x \\in [-\\pi,\\pi]</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">u</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2806em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">t</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7333em;vertical-align:-0.15em;\"></span><span class=\"mord mathnormal\">u</span><span class=\"mord\"><span class=\"mord mathnormal\">u</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">x</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">u</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">xxx</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8389em;vertical-align:-0.1944em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:2em;\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">x</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">∈</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">[</span><span class=\"mord\">−</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">π</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">π</span><span class=\"mclose\">]</span></span></span></span></span>","enumerator":"1","key":"TOGVcajiB9"}],"key":"ErT6c7ZC7Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#%config InlineBackend.figure_format='svg'\nfrom matplotlib.collections import LineCollection\nfrom numpy import pi,cosh,exp,round,zeros,arange,real\nfrom numpy.fft import fft,ifft\nfrom matplotlib.pyplot import figure","key":"ODm64dQcz5"},{"type":"outputs","id":"xjQ6iAFURUCvI495n5x87","children":[],"key":"nQhWU8DuWI"}],"key":"H8N2jWmScK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set up grid and differentiation matrix:\nN = 256; dt = 0.4/N**2; x = (2*pi/N)*arange(-N/2,N/2);\nA, B = 25.0, 16.0\nu = 3*A**2/cosh(0.5*A*(x+2))**2 + 3*B**2/cosh(0.5*B*(x+1))**2\nuhat = fft(u); \nk = zeros(N); k[0:N//2] = arange(0,N/2); k[N//2+1:] = arange(-N/2+1,0,1)\nik3 = 1j * k**3\n\ndef rhs(t,Uhat):\n    uhat = exp(ik3 * t) * Uhat\n    u = real(ifft(uhat))\n    return -0.5j * k * exp(-ik3 * t) * fft(u**2)\n\n# Time-stepping by Runge-Kutta\ntmax = 0.006; nplt = int(round((tmax/25)/dt))\nnmax = int(round(tmax/dt))\nudata = []; udata.append(list(zip(x, u)))\ntdata = [0.0]\nfor n in range(1,nmax+1):\n    t = n*dt\n    Uhat = uhat\n    k1 = rhs(0, Uhat)\n    k2 = rhs(dt/2, Uhat + 0.5 * dt * k1)\n    k3 = rhs(dt/2, Uhat + 0.5 * dt * k2)\n    k4 = rhs(dt,   Uhat +       dt * k3)\n    Uhat = Uhat + (dt/6)*(k1 + 2*k2 + 2*k3 + k4)\n    uhat = exp(ik3 * dt) * Uhat\n    if n%nplt == 0:\n        u = real(ifft(uhat))\n        udata.append(list(zip(x, u)))\n        tdata.append(t);\n\nfig = figure(figsize=(12,10))\nax = fig.add_subplot(111,projection='3d')\npoly = LineCollection(udata)\npoly.set_alpha(0.5)\nax.add_collection3d(poly, zs=tdata, zdir='y')\nax.set_xlabel('x'); ax.set_ylabel('t'); ax.set_zlabel('u')\nax.set_xlim3d(-pi, pi); ax.set_ylim3d(0, tmax); ax.set_zlim3d(0, 2000)\nax.view_init(80,-115);","key":"MJWLKsoAsv"},{"type":"outputs","id":"POPnltSGlawYHJ-l74XGT","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1200x1000 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"61c989cf02d68cfebb513b5849e5f49a","path":"/build/61c989cf02d68cfebb513b5849e5f49a.png"}}},"key":"UzX4gG5sNX"}],"key":"m2vXeUGGto"}],"key":"VcYWneGS7m"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make animation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ilnm0CUpok"}],"identifier":"make-animation","label":"Make animation","html_id":"make-animation","implicit":true,"key":"FubqJdGnN0"}],"key":"yubkIRYb90"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from matplotlib import animation\nimport matplotlib.pyplot as plt\nfrom matplotlib import rc\nrc('animation', html='jshtml')\n\n# First set up the figure, the axis, and the plot element we want to animate\nfig = plt.figure()\nax = plt.axes(xlim=(-pi, pi), ylim=(0, 2000))\nline, = ax.plot([], [], lw=2)\nplt.xlabel('x'); plt.ylabel('u'); plt.close()\n\n# initialization function: plot the background of each frame\ndef init():\n    line.set_data([], [])\n    return line,\n\n# animation function.  This is called sequentially\ndef animate(i):\n    x, u = zip(*udata[i])\n    line.set_data(x, u)\n    return line,\n\n# call the animator.  blit=True means only re-draw the parts that have changed.\nanim = animation.FuncAnimation(fig, animate, init_func=init, repeat=False,\n                               frames=len(udata), interval=50, blit=True)\n# Save to file\ntry:\n    anim.save('p27.mp4', fps=20, extra_args=['-vcodec', 'libx264'])\nexcept:\n    print(\"Cannot save mp4 file\")","key":"QmXFiBPfe6"},{"type":"outputs","id":"yDqxdSbuQXO0Smaz6Ppz6","children":[],"key":"w3RDiKGTC1"}],"key":"GWxYDLuoQ3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Use this for inline display with controls\nanim","key":"Ewo9RDbRcr"},{"type":"outputs","id":"-5QpUO6iIp0uFHktTwCFh","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"<matplotlib.animation.FuncAnimation at 0x10e7bb620>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"8df881b7f5e9da219046e18709cc2ca0","path":"/build/8df881b7f5e9da219046e18709cc2ca0.html"}}},"key":"c7RipA9Gui"}],"key":"j9PlCL4kyf"}],"key":"PjQ95ibRdw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Use this for inline display of movie\n#from IPython.display import HTML\n#HTML(anim.to_html5_video())","key":"sBA3ke59Fp"},{"type":"outputs","id":"Ix9HxEwI0B4XVrE7_qduO","children":[],"key":"y8w7NeoiDq"}],"key":"esBK7XoNmM"}],"key":"lwJlkAiqug"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p26: Eigenvalues of 2nd order Chebyshev diff. matrix","url":"/p26","group":"Spectral Methods"},"next":{"title":"Linear advection equation using FFT and RK4","url":"/linadv1d","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}