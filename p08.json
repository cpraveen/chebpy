position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The exact eigenvalues are ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"VUAgu35BuI"},{"type":"inlineMath","value":"1,2,5,7,\\ldots","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>1</mn><mo separator=\"true\">,</mo><mn>2</mn><mo separator=\"true\">,</mo><mn>5</mn><mo separator=\"true\">,</mo><mn>7</mn><mo separator=\"true\">,</mo><mo>…</mo></mrow><annotation encoding=\"application/x-tex\">1,2,5,7,\\ldots</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8389em;vertical-align:-0.1944em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">5</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">7</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\">…</span></span></span></span>","key":"j0pd9cIMQX"},{"type":"text","value":".","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"YT6uamSmRj"}],"key":"BPGVCwICvk"}],"key":"ZqKCZWnjwk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#%config InlineBackend.figure_format='svg'\nfrom numpy import pi,arange,linspace,sin,zeros,diag,sort,real\nfrom scipy.linalg import toeplitz\nfrom numpy.linalg import eig","key":"OqRld1LqNs"},{"type":"outputs","id":"tq9yeu0e3Ew4IamH0n_zV","children":[],"key":"VQ3xWBdblN"}],"key":"QNAaTllddb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"L = 8.0\nfor N in range(6,37,6):\n    h = 2.0*pi/N; x = h*linspace(1,N,N); x = L*(x-pi)/pi\n    col = zeros(N)\n    col[0] = -pi**2/(3.0*h**2) - 1.0/6.0\n    col[1:] = -0.5*(-1.0)**arange(1,N)/sin(0.5*h*arange(1,N))**2\n    D2 = (pi/L)**2 * toeplitz(col)\n    evals,evecs = eig(-D2 + diag(x**2))\n    eigenvalues = sort(real(evals))\n    print(\"-------- N = %d --------\" % N)\n    for e in eigenvalues[0:4]:\n        print(\"%20.14f\" % e)","key":"Bam30vw151"},{"type":"outputs","id":"blVAYR7B2IesHWi0Xc3zL","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"-------- N = 6 --------\n    0.46147291699548\n    7.49413462105052\n    7.72091605300656\n   28.83248377834010\n-------- N = 12 --------\n    0.97813728129860\n    3.17160532064718\n    4.45593529116678\n    8.92452905811993\n-------- N = 18 --------\n    0.99997000149930\n    3.00064406679582\n    4.99259532440771\n    7.03957189798150\n-------- N = 24 --------\n    0.99999999762904\n    3.00000009841087\n    4.99999796527329\n    7.00002499815654\n-------- N = 30 --------\n    0.99999999999999\n    3.00000000000074\n    4.99999999997561\n    7.00000000050862\n-------- N = 36 --------\n    0.99999999999998\n    3.00000000000000\n    4.99999999999999\n    7.00000000000001\n"},"key":"HthB6Jd731"}],"key":"l5ukM2gaqV"}],"key":"HibYxIn87t"}],"key":"DF3tO4hQj0"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p07: Accuracy of periodic spectral differentiation","url":"/p07","group":"Spectral Methods"},"next":{"title":"p09: Polynomial interpolation in equispaced and chebyshev points","url":"/p09","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}