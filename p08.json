position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The exact eigenvalues are ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"u9EfqMnJMk"},{"type":"inlineMath","value":"1,2,5,7,\\ldots","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>1</mn><mo separator=\"true\">,</mo><mn>2</mn><mo separator=\"true\">,</mo><mn>5</mn><mo separator=\"true\">,</mo><mn>7</mn><mo separator=\"true\">,</mo><mo>…</mo></mrow><annotation encoding=\"application/x-tex\">1,2,5,7,\\ldots</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8389em;vertical-align:-0.1944em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">5</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">7</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\">…</span></span></span></span>","key":"aYqdlX90WS"},{"type":"text","value":".","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"OecPqmuFGf"}],"key":"kZHyjwJJ9h"}],"key":"qYUJrFPBmb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%config InlineBackend.figure_format='svg'\nfrom numpy import pi,arange,linspace,sin,zeros,diag,sort\nfrom scipy.linalg import toeplitz\nfrom numpy.linalg import eig","key":"u1pFvmpk32"},{"type":"outputs","id":"VaTBHMcOla7EMY4a5Er4N","children":[],"key":"ZXd7Zid97h"}],"key":"bmJJbI87x7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"L = 8.0\nfor N in range(6,37,6):\n    h = 2.0*pi/N; x = h*linspace(1,N,N); x = L*(x-pi)/pi\n    col = zeros(N)\n    col[0] = -pi**2/(3.0*h**2) - 1.0/6.0\n    col[1:] = -0.5*(-1.0)**arange(1,N)/sin(0.5*h*arange(1,N))**2\n    D2 = (pi/L)**2 * toeplitz(col)\n    evals,evecs = eig(-D2 + diag(x**2))\n    eigenvalues = sort(evals)\n    print(\"-------- N = %d --------\" % N)\n    for e in eigenvalues[0:4]:\n        print(\"%20.14f\" % e)","key":"DiMvQrmLfM"},{"type":"outputs","id":"6XZDPK67Oq05m25Kp7wKs","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"-------- N = 6 --------\n    0.46147291699547\n    7.49413462105052\n    7.72091605300656\n   28.83248377834012\n-------- N = 12 --------\n    0.97813728129861\n    3.17160532064719\n    4.45593529116679\n    8.92452905811993\n-------- N = 18 --------\n    0.99997000149931\n    3.00064406679583\n    4.99259532440772\n    7.03957189798150\n-------- N = 24 --------\n    0.99999999762904\n    3.00000009841086\n    4.99999796527328\n    7.00002499815654\n-------- N = 30 --------\n    0.99999999999998\n    3.00000000000074\n    4.99999999997560\n    7.00000000050862\n-------- N = 36 --------\n    0.99999999999999\n    3.00000000000000\n    5.00000000000000\n    6.99999999999999\n"},"children":[],"key":"lXjDlGu0zY"}],"key":"VMPqgZuyKp"}],"key":"y2iuqHjmGa"}],"key":"qoultauFpZ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p07: Accuracy of periodic spectral differentiation","url":"/p07","group":"Spectral Methods"},"next":{"title":"p09: Polynomial interpolation in equispaced and chebyshev points","url":"/p09","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}