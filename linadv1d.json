ht:0.8641em;\"><span style=\"top:-3.113em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span><span class=\"mclose\">)</span></span></span></span></span>","enumerator":"2","key":"g6UshCwzMm"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"periodic boundary conditions and RK4 in time.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"XriIcAeNo2"}],"key":"OyWUOoNt0S"}],"key":"iLUZvrjFdJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%config InlineBackend.figure_format='svg'\nfrom pylab import *","key":"T3lDZ1uDc4"},{"type":"outputs","id":"RMWNb1AOWeJ8qnTWkAy9x","children":[],"key":"LRCcFA41aW"}],"key":"JY0AQTEBpg"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Extend ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YHM3GwE9yr"},{"type":"inlineMath","value":"f :[a,b] \\to R","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>f</mi><mo>:</mo><mo stretchy=\"false\">[</mo><mi>a</mi><mo separator=\"true\">,</mo><mi>b</mi><mo stretchy=\"false\">]</mo><mo>→</mo><mi>R</mi></mrow><annotation encoding=\"application/x-tex\">f :[a,b] \\to R</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10764em;\">f</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">:</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">[</span><span class=\"mord mathnormal\">a</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">b</span><span class=\"mclose\">]</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.00773em;\">R</span></span></span></span>","key":"NXpCV7X7kE"},{"type":"text","value":" periodically to whole of ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ATnHbEOCuz"},{"type":"inlineMath","value":"R","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>R</mi></mrow><annotation encoding=\"application/x-tex\">R</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.00773em;\">R</span></span></span></span>","key":"tHxULICDkR"},{"type":"text","value":".","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Hgu1td069l"}],"key":"kEzeoKsws0"}],"key":"h2Va5xzlcw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Evaluate f:[a,b] -> R at given x by extending periodically\ndef periodic(a,b,f,x):\n    y = a + mod(x-a, b-a)\n    fv = vectorize(f)\n    return fv(y)","key":"OVvdiZzr4k"},{"type":"outputs","id":"dNf_W644Z0UyrDc02VKRg","children":[],"key":"mRDigYfikD"}],"key":"F28olG1g7F"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Solve the problem.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RC76G0kg43"}],"key":"KIxlggUQAQ"}],"key":"GmILfwwi74"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set up grid and differentiation matrix:\nN = 128; h = 2*pi/N; x = h*arange(1,N+1);\nt = 0.0; dt = h/4.0\ntmax = 2 * pi; tplot = 0.10;\nplotgap = int(round(tplot/dt)); dt = tplot/plotgap;\nnplots = int(round(tmax/tplot))\n\nc = 1.0\nf = lambda x: sin(20*x) * exp(-5*(x-pi)**2)\nv = f(x)\n\n# wave numbers\nik = 1j*zeros(N)\nik[0:N//2+1] = 1j*arange(0,N//2+1)\nik[N//2+1:]  = 1j*arange(-N//2+1,0,1)\n\ndef diff(u):\n    u_hat = fft(u)\n    w_hat = ik * u_hat\n    w_hat[N//2] = 0.0\n    return real(ifft(w_hat))\n\n# Time-stepping by leap-frog formula\ndata = []; data.append(list(zip(x, v)))\ntdata = []; tdata.append(0.0)\nfor i in range(1,nplots):\n    for n in range(plotgap):\n        t = t + dt\n        k1 = -c * dt * diff(v)\n        k2 = -c * dt * diff(v+0.5*k1)\n        k3 = -c * dt * diff(v+0.5*k2)\n        k4 = -c * dt * diff(v+k3)\n        v += (1.0/6.0)*(k1 + 2.0*k2 + 2.0*k3 + k4)\n    data.append(list(zip(x, v)))\n    tdata.append(t);","key":"kPeSZtBcvq"},{"type":"outputs","id":"AsXfLwfRru6UkUsY9A66I","children":[],"key":"fgoU4Bga7g"}],"key":"Log2iaFkfO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make animation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KJ4dpcuczy"}],"identifier":"make-animation","label":"Make animation","html_id":"make-animation","implicit":true,"key":"T2DOW2Jdv9"}],"key":"m55gKR6jZF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from matplotlib import animation\nfrom matplotlib import rc\nrc('animation', html='jshtml')\n\n# First set up the figure, the axis, and the plot element we want to animate\nfig = figure(figsize=(10,6))\nax = axes(xlim=(0, 2*pi), ylim=(-1.1, 1.1))\nline, = ax.plot([], [], 'r-', lw=2, label='u')\nexact, = ax.plot([], [], 'b-', lw=1, label='exact')\nax.legend(loc='upper left')\nax.grid(True); ax.set_xlabel('x'); ax.set_ylabel('u')\nclose();\n\n# initialization function: plot the background of each frame\ndef init():\n    line.set_data([], [])\n    return line,\n\n# animation function.  This is called sequentially\ndef animate(i):\n    x, v = zip(*data[i])\n    line.set_data(x, v)\n    vexact = periodic(0, 2*pi, f, array(x)-c*tdata[i])\n    exact.set_data(x, vexact)\n    return line,exact\n\n# call the animator.  blit=True means only re-draw the parts that have changed.\nanim = animation.FuncAnimation(fig, animate, init_func=init, repeat=False,\n                               frames=len(data), interval=50, blit=True)\n# Save to file\ntry:\n    anim.save('linadv1d.mp4', fps=20, extra_args=['-vcodec', 'libx264'])\nexcept:\n    print(\"Cannot save mp4 file\")","key":"YAS7BNJWWt"},{"type":"outputs","id":"OnkAEiAb3vuOt2Drihsc_","children":[],"key":"of7h264Gqn"}],"key":"v7wLwSMrmr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Use this for inline display with controls\nanim","key":"ZXVuXuEUrk"},{"type":"outputs","id":"VoTTIEtwKgtqFGDJTU-tA","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/html":{"content_type":"text/html","hash":"abc07557aa2580eb848c266aa9a4f300","path":"/build/abc07557aa2580eb848c266aa9a4f300.html"},"text/plain":{"content":"<matplotlib.animation.FuncAnimation at 0x11b66fec0>","content_type":"text/plain"}}},"children":[],"key":"Q3ea8lcZIa"}],"key":"hX5zu7D3aO"}],"key":"ylQy6nF28C"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare this to a 6th order finite difference scheme from ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vQkwb6G4ex"},{"type":"link","url":"https://github.com/cpraveen/numpde/blob/master/linhyp1d/rk4cs.py","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"here","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oR1LLLK2j0"}],"urlSource":"https://github.com/cpraveen/numpde/blob/master/linhyp1d/rk4cs.py","data":{"kind":"file","org":"cpraveen","repo":"numpde","reference":"master","file":"linhyp1d/rk4cs.py","raw":"https://raw.githubusercontent.com/cpraveen/numpde/master/linhyp1d/rk4cs.py"},"internal":false,"protocol":"github","key":"oT1IYnbF7v"},{"type":"text","value":":","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wOy2RgLzj6"}],"key":"m30UjTYR8S"},{"type":"code","lang":"shell","value":"python rk4cs.py -N 128 -cfl 0.25 -ic wpack -order 6","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"key":"zvqJT9tmSk"}],"key":"HG8fA6SLRL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Use this for inline display of movie\n#from IPython.display import HTML\n#HTML(anim.to_html5_video())","key":"JmwhGXERav"},{"type":"outputs","id":"Lnhhf_YI4bLQtxhKWfe9z","children":[],"key":"BDtKDXm8Ix"}],"key":"QpimCuV7jB"}],"key":"WxR9NOFc5L"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p27: Solve KdV equation","url":"/p27","group":"Spectral Methods"},"next":{"title":"Burgers equation using FFT","url":"/burgers1","group":"Spectral Methods"}}},"domain":"http: