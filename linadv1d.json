=\"height:0.8641em;\"><span style=\"top:-3.113em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span><span class=\"mclose\">)</span></span></span></span></span>","enumerator":"2","key":"HALtj9raF8"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"periodic boundary conditions and RK4 in time.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"ZzEoap9dEI"}],"key":"vO8Ce3tdoR"}],"key":"ekYjXV1a54"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#%config InlineBackend.figure_format='svg'\nfrom pylab import *","key":"N8e5KaMQbZ"},{"type":"outputs","id":"JN_sdkQfJTZeLdGu3kmBR","children":[],"key":"LFEqdwVaAk"}],"key":"pWB4oD92m1"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Extend ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YaegI74Ead"},{"type":"inlineMath","value":"f :[a,b] \\to R","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>f</mi><mo>:</mo><mo stretchy=\"false\">[</mo><mi>a</mi><mo separator=\"true\">,</mo><mi>b</mi><mo stretchy=\"false\">]</mo><mo>→</mo><mi>R</mi></mrow><annotation encoding=\"application/x-tex\">f :[a,b] \\to R</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10764em;\">f</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">:</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">[</span><span class=\"mord mathnormal\">a</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">b</span><span class=\"mclose\">]</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.00773em;\">R</span></span></span></span>","key":"VZBk7piHFR"},{"type":"text","value":" periodically to whole of ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ywCvDV08iv"},{"type":"inlineMath","value":"R","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>R</mi></mrow><annotation encoding=\"application/x-tex\">R</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.00773em;\">R</span></span></span></span>","key":"wfnv9WfRSH"},{"type":"text","value":".","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PdH0iwFYDa"}],"key":"IZR9PVvJji"}],"key":"QYwrIx1rki"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Evaluate f:[a,b] -> R at given x by extending periodically\ndef periodic(a,b,f,x):\n    y = a + mod(x-a, b-a)\n    fv = vectorize(f)\n    return fv(y)","key":"GZKn4PGgST"},{"type":"outputs","id":"KGW4vxGINmA2IMK7bs6_I","children":[],"key":"JfWF7idFhD"}],"key":"wFfKLZtyEo"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Solve the problem.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"v4G35GbOEY"}],"key":"uDHW6s3QaD"}],"key":"Y9jAQIheDb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set up grid and differentiation matrix:\nN = 128; h = 2*pi/N; x = h*arange(1,N+1);\nt = 0.0; dt = h/4.0\ntmax = 2 * pi; tplot = 0.10;\nplotgap = int(round(tplot/dt)); dt = tplot/plotgap;\nnplots = int(round(tmax/tplot))\n\nc = 1.0\nf = lambda x: sin(20*x) * exp(-5*(x-pi)**2)\nv = f(x)\n\n# wave numbers\nik = 1j*zeros(N)\nik[0:N//2+1] = 1j*arange(0,N//2+1)\nik[N//2+1:]  = 1j*arange(-N//2+1,0,1)\n\ndef diff(u):\n    u_hat = fft(u)\n    w_hat = ik * u_hat\n    w_hat[N//2] = 0.0\n    return real(ifft(w_hat))\n\n# Time-stepping by leap-frog formula\ndata = []; data.append(list(zip(x, v)))\ntdata = []; tdata.append(0.0)\nfor i in range(1,nplots):\n    for n in range(plotgap):\n        t = t + dt\n        k1 = -c * dt * diff(v)\n        k2 = -c * dt * diff(v+0.5*k1)\n        k3 = -c * dt * diff(v+0.5*k2)\n        k4 = -c * dt * diff(v+k3)\n        v += (1.0/6.0)*(k1 + 2.0*k2 + 2.0*k3 + k4)\n    data.append(list(zip(x, v)))\n    tdata.append(t);","key":"HCGw797OjB"},{"type":"outputs","id":"2612Ho59yyjBP74GTmlvh","children":[],"key":"XaGLtuQ9LC"}],"key":"xj1LsmVK4g"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Make animation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZVC0lhpx2r"}],"identifier":"make-animation","label":"Make animation","html_id":"make-animation","implicit":true,"key":"j1fWvgt4K4"}],"key":"LF29D4s7A8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from matplotlib import animation\nfrom matplotlib import rc\nrc('animation', html='jshtml')\n\n# First set up the figure, the axis, and the plot element we want to animate\nfig = figure(figsize=(10,6))\nax = axes(xlim=(0, 2*pi), ylim=(-1.1, 1.1))\nline, = ax.plot([], [], 'r-', lw=2, label='u')\nexact, = ax.plot([], [], 'b-', lw=1, label='exact')\nax.legend(loc='upper left')\nax.grid(True); ax.set_xlabel('x'); ax.set_ylabel('u')\nclose();\n\n# initialization function: plot the background of each frame\ndef init():\n    line.set_data([], [])\n    return line,\n\n# animation function.  This is called sequentially\ndef animate(i):\n    x, v = zip(*data[i])\n    line.set_data(x, v)\n    vexact = periodic(0, 2*pi, f, array(x)-c*tdata[i])\n    exact.set_data(x, vexact)\n    return line,exact\n\n# call the animator.  blit=True means only re-draw the parts that have changed.\nanim = animation.FuncAnimation(fig, animate, init_func=init, repeat=False,\n                               frames=len(data), interval=50, blit=True)\n# Save to file\ntry:\n    anim.save('linadv1d.mp4', fps=20, extra_args=['-vcodec', 'libx264'])\nexcept:\n    print(\"Cannot save mp4 file\")","key":"JMj0ncSzBf"},{"type":"outputs","id":"UvjtwnHUw2fvhKhlKyU7X","children":[],"key":"W9vJuM6XnN"}],"key":"vo4fVbvutr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Use this for inline display with controls\nanim","key":"VXpN93YdKu"},{"type":"outputs","id":"hjp54Xat1JSbVHBtO_i73","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/plain":{"content":"<matplotlib.animation.FuncAnimation at 0x11791da90>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"486f494f36b51b4b46a74afcef5ff589","path":"/chebpy/bui