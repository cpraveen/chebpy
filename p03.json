e\n    else:\n        v = maximum(0.0,1.0-abs(x)/3.0) # hat function\n    plot(x,v,'o'); grid(True)\n    \n    # Evaluate interpolant on xx\n    p = zeros(len(xx))\n    for i in range(len(x)):\n        p = p + v[i]*sin(pi*(xx-x[i])/h)/(pi*(xx-x[i])/h)\n    plot(xx,p)\n    axis([-xmax,xmax,-0.5,1.5]);","key":"qIg6EQQlDi"},{"type":"outputs","id":"T6PxcfnRzLmoU5N59vlcs","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x1000 with 3 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"856da184709fd685fc23ce03ee0fa134","path":"/build/856da184709fd685fc23ce03ee0fa134.png"}}},"key":"QE3ntXh3Wa"}],"key":"TdtczdJth6"}],"key":"OxE6LHo8TZ"}],"key":"GESrAhONvo"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p02: Convergence of periodic spectral method","url":"/p02","group":"Spectral Methods"},"next":{"title":"p04: Periodic spectral differentiation","url":"/p04","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}