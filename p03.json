\n    else:\n        v = maximum(0.0,1.0-abs(x)/3.0) # hat function\n    plot(x,v,'o'); grid(True)\n    \n    # Evaluate interpolant on xx\n    p = zeros(len(xx))\n    for i in range(len(x)):\n        p = p + v[i]*sin(pi*(xx-x[i])/h)/(pi*(xx-x[i])/h)\n    plot(xx,p)\n    axis([-xmax,xmax,-0.5,1.5]);","key":"P0jPA4PggF"},{"type":"outputs","id":"vi2RB-Etqusnch4SCjMFh","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/svg+xml":{"content_type":"image/svg+xml","hash":"166adb83fd4985608b403651ae11f3f1","path":"/build/166adb83fd4985608b403651ae11f3f1.svg"},"text/plain":{"content":"<Figure size 1000x1000 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"SXJH3VIDWI"}],"key":"XnacaZOmmP"}],"key":"IggB2Y9oaP"}],"key":"MJ4Peo1fTI"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p02: Convergence of periodic spectral method","url":"/p02","group":"Spectral Methods"},"next":{"title":"p04: Periodic spectral differentiation","url":"/p04","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}