re wave\n    else:\n        v = maximum(0.0,1.0-abs(x)/3.0) # hat function\n    plot(x,v,'o'); grid(True)\n    \n    # Evaluate interpolant on xx\n    p = zeros(len(xx))\n    for i in range(len(x)):\n        p = p + v[i]*sin(pi*(xx-x[i])/h)/(pi*(xx-x[i])/h)\n    plot(xx,p)\n    axis([-xmax,xmax,-0.5,1.5]);","key":"gQbSD9uVzq"},{"type":"outputs","id":"wOGIg9LALKGAXHZAlE15X","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x1000 with 3 Axes>","content_type":"text/plain"},"image/svg+xml":{"content_type":"image/svg+xml","hash":"3339d408b97f34eabdc86b4aa0775a12","path":"/chebpy/build/3339d408b97f34eabdc86b4aa0775a12.svg"}}},"key":"AFaQ4p4sbP"}],"key":"Qa2topDHBQ"}],"key":"CIXyaXZDzo"}],"key":"aCHeiNJa1L"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p02: Convergence of periodic spectral method","url":"/p02","group":"Spectral Methods"},"next":{"title":"p04: Periodic spectral differentiation","url":"/p04","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}