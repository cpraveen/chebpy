solve(D2,f)\ns = zeros(N+1)\ns[0:N] = u\n\n# Compute error\nxx = linspace(-1.0,1.0,200)\nuu = polyval(polyfit(x,s,N),xx)    # interpolate grid data\nexact = (exp(4.0*xx) - 4.0*exp(-4.0)*(xx-1.0) - exp(4.0))/16.0\nmaxerr = norm(uu-exact,inf)\n\ntitle('max err = %e' % maxerr)\nplot(x,s,'o',xx,exact)\nxlabel('x'); ylabel('u'); grid(True);","key":"dEQaAwP0YZ"},{"type":"outputs","id":"P41YBTgcPYEe1zUDX9YFx","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/svg+xml":{"content_type":"image/svg+xml","hash":"7bb7eaa7c8ef247345d2ac94f3bf7b17","path":"/chebpy/build/7bb7eaa7c8ef247345d2ac94f3bf7b17.svg"}}},"key":"hNHSYjntOL"}],"key":"edQ1IdrC0H"}],"key":"LRiXy9ZAOY"}],"key":"foP92CCNPd"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p32: Solve linear BVP","url":"/p32","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}