{"version":3,"kind":"Notebook","sha256":"205a58d18263116c675f990658bfbef875ce060f1ba2b13b43bd2e9cc381f6ba","slug":"p21","location":"/p21.ipynb","dependencies":[],"frontmatter":{"title":"p21: Eigenvalues of Mathieu operator","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Praveen Chandrashekar","given":"Praveen","family":"Chandrashekar"},"name":"Praveen Chandrashekar","github":"cfdlab","twitter":"cfdlab","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cpraveen/chebpy","copyright":"2026","source_url":"https://github.com/cpraveen/chebpy/blob/master/p21.ipynb","edit_url":"https://github.com/cpraveen/chebpy/edit/master/p21.ipynb","exports":[{"format":"ipynb","filename":"p21.ipynb","url":"/build/p21-5d5230bc63aa8e413b0b322bb19b1a39.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%config InlineBackend.figure_format='svg'\nfrom numpy import pi,arange,sin,cos,zeros,diag,sort,real\nfrom scipy.linalg import toeplitz\nfrom numpy.linalg import eig\nfrom itertools import cycle\nfrom matplotlib.pyplot import figure,plot,xlabel,ylabel","key":"Kfu2KZgJT7"},{"type":"outputs","id":"NRyJW6MDVwlsJxtJ3698z","children":[],"key":"WqD1JRLP9O"}],"key":"GFQ8UfN5pV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"N = 42; h = 2.0*pi/N; x = h*arange(1,N+1)\ncol = zeros(N)\ncol[0] = -pi**2/(3.0*h**2) - 1.0/6.0\ncol[1:] = -0.5*(-1.0)**arange(1,N)/sin(0.5*h*arange(1,N))**2\nD2 = toeplitz(col)\n\nne = 11 # number of eigenvalues to plot\nqq = arange(0.0, 15.0, 0.2)\ndata= zeros((len(qq),ne))\ni = 0\nfor q in qq:\n    evals,evecs = eig(-D2 + 2.0*q*diag(cos(2.0*x)))\n    e = real(sort(evals))\n    data[i,:] = e[0:ne]\n    i = i + 1\n    \nfigure(figsize=(5,10))\nlines=cycle([\"-\",\"--\"])\nfor i in range(ne):\n    plot(qq,data[:,i],next(lines))\nxlabel(\"q\")\nylabel(\"$\\\\lambda$\");","key":"mIpnbIqp5B"},{"type":"outputs","id":"_BrqCBtti_EFLaigsFThs","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/svg+xml":{"content_type":"image/svg+xml","hash":"92be7d8bb08e064b9fc46942ce82ef72","path":"/build/92be7d8bb08e064b9fc46942ce82ef72.svg"},"text/plain":{"content":"<Figure size 500x1000 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"h2kaPy6HZQ"}],"key":"Kge0KkTxI8"}],"key":"FJ95ecbo3n"}],"key":"oXiI5ND8qA"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p20: Second order wave equation in 2-D via FFT","url":"/p20","group":"Spectral Methods"},"next":{"title":"p22: 5’th eigenvector of Airy equation","url":"/p22","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}