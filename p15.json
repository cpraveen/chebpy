cutable":true,"value":"#%config InlineBackend.figure_format='svg'\nfrom pylab import *\nfrom chebPy import cheb\nfrom scipy.linalg import solve,eig\nfrom scipy.interpolate import barycentric_interpolate","key":"LntLiSvTDB"},{"type":"outputs","id":"J8os1_NeH_HBOlrOxpdEX","children":[],"key":"wCfpgB78Ys"}],"key":"HH86XM93kZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"N = 36\nD,x = cheb(N)\nD2 = dot(D,D)\nD2 = D2[1:N,1:N]\n\nlam,V = eig(D2)   \nii = argsort(-lam)\nlam = real(lam[ii])\nV = V[:,ii]\n\nfig = figure(figsize=(10,15))\nfor j in range(5,35,5):              \n    lv = shape(V)[0]+2\n    u = zeros(lv)\n    u[1:lv-1] = V[:,int(j)]  \n    subplot(6,1,j//5)\n    plot(x,u,'bo')\n    xx = linspace(-1.0,1.0,501)\n    uu = barycentric_interpolate(x,u,xx)\n    s = 'eig %d = %20.13f * $\\\\pi^2/4$' %(j,lam[j-1]*4/pi**2)\n    s = s + '\\t\\t %4.1f ppw' % (4*N/(pi*j))\n    title(s)\n    plot(xx,uu,'b')\n    axis('off')","key":"UhxDTl8Tw5"},{"type":"outputs","id":"vzEwWWFPtJU_3k-EeP7lp","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x1500 with 6 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"44b03c51bda3e3c7a5cc72ab7596ee7e","path":"/chebpy/build/44b03c51bda3e3c7a5cc72ab7596ee7e.png"}}},"key":"iztrXYx5H4"}],"key":"cAN8CzS7h6"}],"key":"gNpZOxWzhz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"lexact = - pi**2/4 * arange(1,N)**2\nerror = abs((lam - lexact)/lexact)\nsemilogy(error,'o')\ngrid(True), xlabel('n'), ylabel('Error in $\\\\lambda_n$');","key":"bj0Q0E6Coh"},{"type":"outputs","id":"JkC-vNWIEIhj6iPlaWxI3","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},