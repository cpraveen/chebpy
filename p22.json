{"version":3,"kind":"Notebook","sha256":"1cb43987511c919cc788ffaef642005d5c00a5d59010d345d817c8b9bcd7882c","slug":"p22","location":"/p22.ipynb","dependencies":[],"frontmatter":{"title":"p22: 5’th eigenvector of Airy equation","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Praveen Chandrashekar","given":"Praveen","family":"Chandrashekar"},"name":"Praveen Chandrashekar","github":"cfdlab","twitter":"cfdlab","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cpraveen/chebpy","copyright":"2026","source_url":"https://github.com/cpraveen/chebpy/blob/master/p22.ipynb","edit_url":"https://github.com/cpraveen/chebpy/edit/master/p22.ipynb","exports":[{"format":"ipynb","filename":"p22.ipynb","url":"/chebpy/build/p22-c65df518dfca3e666f5d41553f3c8c03.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#%config InlineBackend.figure_format='svg'\nfrom chebPy import *\nfrom numpy import dot,diag,real,argsort,zeros,linspace,polyval,polyfit,where\nfrom numpy.polynomial import Legendre\nfrom scipy.linalg import eig\nfrom scipy.special import airy\nfrom matplotlib.pyplot import figure,subplot,plot,title,grid","key":"zxnbOB3azf"},{"type":"outputs","id":"HGP3Sn0Rvjxn1pSJIZBfT","children":[],"key":"lKNwcsJf0Q"}],"key":"oxxN1woX0L"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"figure(figsize=(10,8))\nfor N in range(12,60,12):\n    D,x = cheb(N); D2 = dot(D,D); D2 = D2[1:N,1:N]\n    Lam,V = eig(D2,diag(x[1:N]))\n    Lam = real(Lam); ii = where(Lam>0)[0]\n    V = real(V[:,ii]); Lam = Lam[ii]\n    ii = argsort(Lam); ii=ii[4]; Lam=Lam[ii]\n    v = zeros(N+1); v[1:N] = V[:,ii]; v = v/v[N//2]*airy(0.0)[0]\n    xx = linspace(-1.0,1.0,200); # vv = polyval(polyfit(x,v,N),xx); # polyfit is illconditioned\n    VV = Legendre.fit(x,v,N); vv = VV(xx)\n    subplot(2,2,N//12); plot(xx,vv); grid(True)\n    title(\"N = %d,   eig = %15.10f\"%(N,Lam));","key":"XAiTlirgvA"},{"type":"outputs","id":"8SV5kqoNQpjuLEUp-D_tr","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x800 with 4 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"07fb7b05b6ad0d6c2b78458ff2c06137","path":"/chebpy/build/07fb7b05b6ad0d6c2b78458ff2c06137.png"}}},"key":"TmgEgXKp18"}],"key":"a2VdCMOH5A"}],"key":"Q0i23ZdbRx"}],"key":"Q10LRmIscO"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"p21: Eigenvalues of Mathieu operator","url":"/p21","group":"Spectral Methods"},"next":{"title":"p23: Eigenvalues of Laplacian in 2-D","url":"/p23","group":"Spectral Methods"}}},"domain":"http://localhost:3000"}